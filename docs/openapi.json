  "components": {
    "schemas": {
      "Decision": {
        "additionalProperties": false,
        "properties": {
          "approve": {
            "title": "Approve",
            "type": "boolean"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "approve",
          "reason"
        ],
        "title": "Decision",
        "type": "object"
